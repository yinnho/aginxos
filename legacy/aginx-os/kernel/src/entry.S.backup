/*
 * Aginx OS - aarch64 entry point and exception vector table (redfin / no MMU)
 *
 * The bootloader loads the kernel at PA 0x10000000.
 * No MMU: PA = VA identity mapping.
 * We place the vector table at a 2KB-aligned address within the image
 * (after the boot code), then set VBAR_EL1 to point to it.
 */

    .global NEW_TASK_SP
    .global OLD_TASK_SP_PTR

    /* ── Boot / Entry code (placed first in flat image) ── */
    .section .init.boot, "ax", %progbits

    .global _start
    .type _start, %function
_start:
    /* ── ARM64 Linux Image Header (64 bytes) ── */
    b .Lkernel_entry            /* 0x00: branch to real entry at offset 0x40 */
    .long 0                     /* 0x04: code1 */
    .quad 0x80000               /* 0x08: text_offset (ABL loads at DRAM+0x80000) */
    .quad _kernel_end - _start  /* 0x10: image_size (filled by linker) */
    .quad 0xa                   /* 0x18: flags (16K pages, 2MB aligned) */
    .quad 0                     /* 0x20: res2 */
    .quad 0                     /* 0x28: res3 */
    .quad 0                     /* 0x30: res4 */
    .long 0x644d5241            /* 0x38: magic "ARM\x64" */
    .long 0                     /* 0x3c: PE header offset (0 = no PE) */

.Lkernel_entry:
    /* Save DTB address (x0) from ABL before we clobber registers */
    adrp x6, _dtb_ptr
    str x0, [x6, #:lo12:_dtb_ptr]

    /* Set up stack: just after kernel_end (approx 0x80087000) */
    adrp x2, _kernel_end
    add x2, x2, :lo12:_kernel_end
    add x2, x2, #0x1000          /* Add 4KB padding */
    mov sp, x2

    /* kernel_end = _kernel_end (from linker script) */
    adrp x0, _kernel_end
    add x0, x0, :lo12:_kernel_end

    mov x1, xzr               /* page_table_arg = 0 */
    mov x2, xzr               /* (unused arg3) */

    /* Set VBAR_EL1 to vector table (at 2KB-aligned address) */
    adrp x3, _vector_table
    add x3, x3, :lo12:_vector_table
    msr VBAR_EL1, x3

    /* Zero BSS: from __bss_start to _kernel_end */
    adrp x4, __bss_start
    add x4, x4, :lo12:__bss_start
    adrp x5, _kernel_end
    add x5, x5, :lo12:_kernel_end
    sub x5, x5, x4           /* bss_size */
    cbz x5, .Lno_bss
    and x5, x5, #~7
.Lbss_loop:
    stp xzr, xzr, [x4], #16
    subs x5, x5, #16
    b.gt .Lbss_loop
.Lno_bss:

    /* ── Disable MMU, caches, and TLBs ──────────────────────────── */
    /* ABL may leave MMU enabled. Our kernel writes physical addresses, */
    /* but with MMU on, those go through VA→PA translation.           */
    /* Disabling MMU ensures VA=PA (identity) for our writes.         */
    /* Temporarily commented out for debugging */
    /*
    mrs x9, SCTLR_EL1
    str x9, [sp, #-16]!   // save on stack and update sp

    bic x9, x9, #0x1
    bic x9, x9, #0x4
    bic x9, x9, #(1 << 12)
    msr SCTLR_EL1, x9
    isb

    tlbi vmalle1is
    dsb sy
    isb
    */

    /* Early framebuffer test: write red pixel at (100,100) */
    movz x10, #0xA000
    movk x10, #0x0000, lsl #16
    movk x10, #0x0000, lsl #32
    movk x10, #0x0000, lsl #48  /* x10 = 0xA0000000 */
    movz x11, #0x6991           /* offset low 16 bits */
    movk x11, #0x0000, lsl #16  /* offset high 16 bits */
    add x10, x10, x11           /* x10 = 0xA0069910 */
    movz x12, #0x00FF           /* red pixel BGRA: 0x000000FF */
    str w12, [x10]

    bl rust_main

    /* rust_main never returns */
.Lhalt:
    wfi
    b .Lhalt

    /* ── Exception Vector Table ─────────────────────────────────────── */
    /* 16 entries: 4 exception types × 4 EL transitions                */
    /* Each entry has 0x80 (128) bytes                                   */
    /* Placed at 2KB-aligned address via linker script                  */
    .section .init.vector, "ax", %progbits
    .balign 0x800

    .global _vector_table
    .type _vector_table, %function
_vector_table:

    /* Current EL with SPx */
    .balign 0x80
    b hang
    .balign 0x80
    b hang
    .balign 0x80
    b hang
    .balign 0x80
    b hang

    /* Current EL with SPx (IRQ path uses exc_irq_spx) */
    .balign 0x80
    b exc_sync_spx
    .balign 0x80
    b exc_irq_spx
    .balign 0x80
    b hang
    .balign 0x80
    b hang

    /* Lower EL using AArch64 */
    .balign 0x80
    b hang
    .balign 0x80
    b hang
    .balign 0x80
    b hang
    .balign 0x80
    b hang

    /* Lower EL using AArch32 */
    .balign 0x80
    b hang
    .balign 0x80
    b hang
    .balign 0x80
    b hang
    .balign 0x80
    b hang

    /* ── Hang (catch-all for unhandled exceptions) → PSCI reset ─────── */
hang:
    movz x0, #0x0009
    movk x0, #0x8400, lsl #16
    smc #0
    wfe
    b hang

    /* ── Synchronous Exception (Current EL SPx) → PSCI reset ─────── */
exc_sync_spx:
    movz x0, #0x0009
    movk x0, #0x8400, lsl #16
    smc #0
    b hang

    /* ── IRQ Handler (Current EL SPx) ──────────────────────────────── */
exc_irq_spx:
    /* Save registers to stack */
    sub sp, sp, #272

    stp x0, x1, [sp, #0]
    stp x2, x3, [sp, #16]
    stp x4, x5, [sp, #32]
    stp x6, x7, [sp, #48]
    stp x8, x9, [sp, #64]
    stp x10, x11, [sp, #80]
    stp x12, x13, [sp, #96]
    stp x14, x15, [sp, #112]
    stp x16, x17, [sp, #128]
    stp x18, x19, [sp, #144]
    stp x20, x21, [sp, #160]
    stp x22, x23, [sp, #176]
    stp x24, x25, [sp, #192]
    stp x26, x27, [sp, #208]
    stp x28, x29, [sp, #224]
    stp x30, xzr, [sp, #240]

    mrs x0, ELR_EL1
    mrs x1, SPSR_EL1
    stp x0, x1, [sp, #256]

    bl handle_irq

    /* Context switch */
    adrp x2, NEW_TASK_SP
    ldr x2, [x2, #:lo12:NEW_TASK_SP]
    cbz x2, .Lno_switch

    adrp x3, OLD_TASK_SP_PTR
    ldr x3, [x3, #:lo12:OLD_TASK_SP_PTR]
    mov x4, sp
    str x4, [x3]
    mov sp, x2
    adrp x2, NEW_TASK_SP
    str xzr, [x2, #:lo12:NEW_TASK_SP]

.Lno_switch:
    ldp x0, x1, [sp, #256]
    msr ELR_EL1, x0
    msr SPSR_EL1, x1

    ldp x30, xzr, [sp, #240]
    ldp x28, x29, [sp, #224]
    ldp x26, x27, [sp, #208]
    ldp x24, x25, [sp, #192]
    ldp x22, x23, [sp, #176]
    ldp x20, x21, [sp, #160]
    ldp x18, x19, [sp, #144]
    ldp x16, x17, [sp, #128]
    ldp x14, x15, [sp, #112]
    ldp x12, x13, [sp, #96]
    ldp x10, x11, [sp, #80]
    ldp x8, x9, [sp, #64]
    ldp x6, x7, [sp, #48]
    ldp x4, x5, [sp, #32]
    ldp x2, x3, [sp, #16]
    ldp x0, x1, [sp, #0]
    add sp, sp, #272
    eret

    /* ── Global: DTB address saved from x0 ── */
    .section .data
    .global _dtb_ptr
    .balign 8
_dtb_ptr:
    .quad 0
