#!/bin/sh
# ag:summary=secret store admin face: set, get, rm, list, sign (agsecretd sidecar)
# ag:args=set <scope> | get <scope> | env <name> | rm <scope> | list | sign <scope> <string>
# ag:examples=set brain.primary   (value on stdin)
# ag:examples=list
# ag:exec=agsecret
# ag:group=sec
# M36 secret sidecar (DECISIONS §9). `set` reads the value from stdin —
# argv leaks via ps and shell history. Values live in agsecretd's store
# (/var/lib/ag/secret/store, 0600); this CLI is the admin-allowlisted
# exe for put/rm/list.
exec /usr/bin/agsecret "$@"
