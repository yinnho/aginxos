#!/bin/sh
# agpkg v0 — AginxOS package installer (docs/SYSTEM.md §6.1).
#
# A package is a static musl binary + this convention:
#   /var/bin/<name>        installed binary
#   /var/bin/.<name>.prev  previous version (rollback)
#   /var/apps/<name>/      data dir
#
# v0 is adb-fed: SRC is a local file already on the device. Network download
# arrives with M10 — this busybox's wget segfaults and httpget is HTTP-only
# (see src/httpget.c), so an HTTPS fetcher is an M10 deliverable.
#
# Manifest lines (M23 tiering): <name> <url> <sha256> [core|opt] — the 4th
# field is optional, absent = core. `sync` self-heals core entries only;
# opt entries are user-picked (`available` lists them, `opt-in` installs
# one and seeds its launcher registry entry). '#' comments, blank ok.
#
# usage:
#   agpkg install <name> <src-file> <sha256>
#   agpkg sync [manifest]   — download + install every CORE manifest entry
#                             whose installed sha256 differs (M10 self-heal)
#   agpkg available [manifest] — opt entries not yet installed, one per line
#   agpkg opt-in <name>     — download + install an opt entry and seed
#                             /var/apps/<name>/app.toml (launcher shows it)
#   agpkg rollback <name>
#   agpkg list
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/var/bin

BINDIR=/var/bin
APPDIR=/var/apps
MANIFEST=${AGPKG_MANIFEST:-/etc/agpkg.manifest}
DL=/var/tmp/agpkg

cmd=${1:-}
name=${2:-}

# fetch_install <name> <url> <sha256> — shared by sync and opt-in.
# Downloads (with the gh-proxy retry) then installs via `install`; returns
# nonzero and keeps the previous binary on any failure.
fetch_install() {
  fp=$1; furl=$2; fsum=$3
  mkdir -p "$DL"
  f="$DL/$fp"
  rm -f "$f"
  # GitHub release downloads get TLS-reset on some networks; retry once
  # through gh-proxy.com (content is sha256-pinned either way).
  if ! agdl "$furl" "$f"; then
    case "$furl" in
      https://github.com/*) agdl "https://gh-proxy.com/$furl" "$f" || true ;;
    esac
  fi
  if [ -f "$f" ] && "$0" install "$fp" "$f" "$fsum"; then
    rm -f "$f"
    return 0
  fi
  rm -f "$f"
  return 1
}

# seed_app <name> — write the launcher registry entry (§12.3) so an
# installed package appears on the launcher without an OS source change.
# Known apps keep their /etc/apps.d seed (scale etc. stay curated); the
# default assumes unknown UIs are PC-designed TUIs (codex/grok class).
seed_app() {
  if [ -f "/etc/apps.d/$1.toml" ]; then
    mkdir -p "$APPDIR/$1"
    cp "/etc/apps.d/$1.toml" "$APPDIR/$1/app.toml"
    return
  fi
  mkdir -p "$APPDIR/$1"
  cat > "$APPDIR/$1/app.toml" <<EOF
name = "$1"
binary = "/var/bin/$1"
args = ""
scale = 3
EOF
}

case "$cmd" in
install)
  src=${3:-}; sum=${4:-}
  [ -n "$src" ] && [ -n "$sum" ] || { echo "usage: agpkg install <name> <src> <sha256>" >&2; exit 2; }
  [ -f "$src" ] || { echo "agpkg: no such file: $src" >&2; exit 1; }
  got=$(sha256sum "$src" | cut -d' ' -f1)
  if [ "$got" != "$sum" ]; then
    echo "agpkg: sha256 mismatch for $name: got $got want $sum" >&2
    exit 1
  fi
  mkdir -p "$BINDIR" "$APPDIR/$name"
  if [ -f "$BINDIR/$name" ]; then
    cp "$BINDIR/$name" "$BINDIR/.$name.prev"
  fi
  # atomic place: same-fs rename
  cp "$src" "$BINDIR/.$name.new"
  chmod 755 "$BINDIR/.$name.new"
  mv "$BINDIR/.$name.new" "$BINDIR/$name"
  echo "agpkg: installed $name ($sum)"
  ;;
rollback)
  [ -f "$BINDIR/.$name.prev" ] || { echo "agpkg: no previous version of $name" >&2; exit 1; }
  mv "$BINDIR/.$name.prev" "$BINDIR/$name"
  echo "agpkg: rolled back $name"
  ;;
sync)
  mf=${2:-$MANIFEST}
  [ -f "$mf" ] || { echo "agpkg: no manifest $mf — nothing to sync"; exit 0; }
  rc=0
  # manifest lines: <name> <url> <sha256> [core|opt] — sync heals CORE only
  while read -r pname purl psum ptier rest; do
    case "$pname" in ''|\#*) continue;; esac
    [ -n "$purl" ] && [ -n "$psum" ] || { echo "agpkg: bad manifest line: $pname" >&2; rc=1; continue; }
    [ "$ptier" = "opt" ] && continue
    cur=
    [ -f "$BINDIR/$pname" ] && cur=$(sha256sum "$BINDIR/$pname" | cut -d' ' -f1)
    if [ "$cur" = "$psum" ]; then
      echo "agpkg: $pname up to date"
      continue
    fi
    if [ -n "$cur" ]; then
      echo "agpkg: $pname stale — downloading"
    else
      echo "agpkg: $pname missing — downloading"
    fi
    if ! fetch_install "$pname" "$purl" "$psum"; then
      echo "agpkg: $pname sync FAILED (kept previous)" >&2
      rc=1
    fi
  done < "$mf"
  exit $rc
  ;;
available)
  mf=${2:-$MANIFEST}
  [ -f "$mf" ] || exit 0
  while read -r pname purl psum ptier rest; do
    case "$pname" in ''|\#*) continue;; esac
    [ "$ptier" = "opt" ] || continue
    [ -f "$BINDIR/$pname" ] && continue
    echo "$pname"
  done < "$mf"
  ;;
opt-in)
  [ -n "$name" ] || { echo "usage: agpkg opt-in <name>" >&2; exit 2; }
  [ -f "$MANIFEST" ] || { echo "agpkg: no manifest $MANIFEST" >&2; exit 1; }
  # field extraction via sed groups only — busybox awk segfaults on this
  # build (see net-bringup); one leading space + `  *` anchors field bounds
  # so "foo" never matches a "foobar ..." line.
  purl=$(sed -n "s/^$name  *\([^ ]*\)  *.*/\1/p" "$MANIFEST" | head -1)
  psum=$(sed -n "s/^$name  *[^ ]*  *\([^ ]*\).*/\1/p" "$MANIFEST" | head -1)
  ptier=$(sed -n "s/^$name  *[^ ]*  *[^ ]*  *\([^ ]*\).*/\1/p" "$MANIFEST" | head -1)
  [ -n "$purl" ] && [ -n "$psum" ] || { echo "agpkg: $name not in manifest" >&2; exit 1; }
  [ "$ptier" = "opt" ] || { echo "agpkg: $name is not an opt entry (sync handles core)" >&2; exit 1; }
  cur=
  [ -f "$BINDIR/$name" ] && cur=$(sha256sum "$BINDIR/$name" | cut -d' ' -f1)
  if [ "$cur" = "$psum" ]; then
    seed_app "$name"
    echo "agpkg: $name already installed — seeded launcher entry"
    exit 0
  fi
  if fetch_install "$name" "$purl" "$psum"; then
    seed_app "$name"
    echo "agpkg: opted in $name"
  else
    echo "agpkg: $name install FAILED" >&2
    exit 1
  fi
  ;;
list)
  for f in "$BINDIR"/*; do
    [ -f "$f" ] || continue
    case "$f" in */.*) continue;; esac
    echo "${f##*/}"
  done
  ;;
*)
  echo "usage: agpkg install <name> <src> <sha256> | sync [manifest] | available [manifest] | opt-in <name> | rollback <name> | list" >&2
  exit 2
  ;;
esac
