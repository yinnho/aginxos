#!/bin/sh
# AginxOS rcS - one-shot setup, runs before the respawns in inittab.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/system/bin

# Fill in the full applet set (image ships only a curated symlink list),
# then populate /dev from sysfs — nothing udevs in our world, so input event
# nodes and friends only exist after mdev runs.
/bin/busybox --install -s /bin 2>/dev/null
mdev -s 2>/dev/null

# Host mke2fs -d stored the macOS build user (uid 501) as owner - the
# filesystem is rw, so the first boot normalizes it for good.
chown -R 0:0 /bin /sbin /etc /aginxos /system /home /root /var /opt /srv /media 2>/dev/null
chown 0:0 /default.prop /prop.default /*_contexts 2>/dev/null

# /proc, /sys and /dev were carried in by aginxos-init before chroot;
# these only run if something is missing (idempotent).
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null

hostname aginxos
ifconfig lo 127.0.0.1 netmask 255.0.0.0 up 2>/dev/null

# Cross-boot forensics: the kernel has no pstore, so a death (PMIC power cut
# vs kernel hang) leaves evidence only if something was already writing it
# to the ext4 /var. The 2026-08-27 morning deaths were diagnosed as UVLO
# power cuts exactly because a kmsg follower was running (last line:
# "PMIC input: code=116"). Heartbeat stamps uptime every 5s — where it
# stops vs when USB died discriminates hang-vs-power on the next death.
(cat /dev/kmsg > /var/kmsg-follow.log 2>/dev/null) &
(while :; do
  echo "$(date +%H%M%S) up=$(cut -d. -f1 /proc/uptime)" >> /var/heartbeat.log
  sleep 5
done) &

echo "aginxos: rcS done, rootfs up on userdata" > /dev/kmsg
date > /etc/.rcs-ran

# Boot card (M5) — the panel UI: AginxOS wordmark + a live checklist of
# every bring-up stage, fed by /run/boot.state. Starts FIRST because it
# must own DRM master as soon as the panel registers (it retries until
# then — msm_drm + panel take ~60 s, loaded by touch-bringup below). It
# replaces the M3 green splash: bring-up scripts report into the state
# file instead of painting, and bootcard never exits (dropping master
# would let dsi_backlight's dpms hooks blank the panel).
mkdir -p /run 2>/dev/null
: > /run/boot.state
( exec /bin/bootcard /run/boot.state ) >/var/bootcard.log 2>&1 &

# Touch bring-up (M3) — backgrounded: it waits out the ~60s panel
# registration, and the console must not block on it. Loads the display
# chain and reports touch ok/fail into /run/boot.state.
/etc/init.d/touch-bringup &

# Battery bring-up (M3c) — backgrounded: google-battery keeps retrying
# until the psy appears, so this script just feeds modules and waits.
/etc/init.d/battery-bringup &

# Radio bring-up (M3d) — backgrounded: stands up the QRTR service stack,
# boots the modem (its own watchdog kills it in 65 s without the services)
# and loads the WLAN driver. Ordering vs touch-bringup is race-tolerant:
# both chains re-insmod with 2>/dev/null.
/etc/init.d/radio-bringup &

# Network bring-up (M5) — backgrounded: waits for wlan0 from radio-bringup,
# joins /etc/wifi.conf, DHCP, then fetches http://www.baidu.com; every step
# lands in /run/boot.state and the card flips to the BOOT COMPLETE banner.
/etc/init.d/net-bringup &
