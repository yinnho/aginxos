#!/bin/sh
# aginx services (M8) — start the aginx stack from /var/bin if installed.
#
# Gateway first (it spawns `aginx-carrier acp` per prompt via the agent
# registry), then the carrier daemon (iLink channel + cron). No ordering
# dependency on net-bringup: the gateway's relay client reconnects until
# Wi-Fi lands.
#
# Config lives in $HOME/.aginx (HOME=/var/home so it persists) — gateway id,
# relay secret and brain key are device-local, never committed.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/var/bin
export HOME=/var/home

# API keys (brain etc.) — device-local, written at provisioning, 0600.
[ -f /etc/aginx/env ] && { set -a; . /etc/aginx/env; set +a; }

STATE=/run/boot.state
say() { echo "$@" >>"$STATE"; }

mkdir -p /var/home /var/log

if [ -x /var/bin/aginx ]; then
  say aginx run
  ( exec /var/bin/aginx ) >/var/log/aginx.log 2>&1 &
else
  say aginx absent
fi

if [ -x /var/bin/aginx-carrier ]; then
  say carrier run
  ( exec /var/bin/aginx-carrier start ) >/var/log/aginx-carrier.log 2>&1 &
else
  say carrier absent
fi
