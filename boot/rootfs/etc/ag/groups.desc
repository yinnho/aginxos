# ag groups.desc — group key = one-line menu description (M24).
# File-is-registry: a package introduces a new group by appending a line
# here, no router reflash. Read by `ag` at menu time; AG_GROUPS_DESC
# overrides for tests and the build-time --check gate.
cam=camera capture and conversion
snd=audio capture, playback, mixer
net=wi-fi scan, join, trace
sys=system control and hardware introspection
pkg=package install and sync
svc=supervised service units
agent=avatar (clone) lifecycle
cron=scheduled tasks
web=browser, search and fetch tools (agb package)
files=file read/write/list/convert tools (agf package)
api=declarative API tool face (named/raw/register/cron)
mem=memory tools: kv, tree, knowledge, flows (agmem package)
sec=secret store admin: set, get, rm, list, sign (agsecretd sidecar)
