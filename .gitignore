/target
.agentos/
*.db
.env
.DS_Store

# Boot working trees & images (local only)
boot/unpack/
boot/out/
boot/tools/
boot/stock-boot.img
boot/initramfs/busybox
boot/initramfs/aginxos-probe
boot/*.img
boot/*.gz
boot/*.cpio

rootfs/work/
rootfs/*.tar*

# Vendor / radio firmware — extract locally, never commit
**/firmware/
**/vendor-firmware/
*.fw
*.mbn
*.elf
*.img
boot/initramfs/aginxos-init
boot/initramfs/aginxos-probe
boot/initramfs/busybox
boot/initramfs/trampoline
boot/initramfs/first_stage_init
boot/initramfs/aginxos-splash

# Local factory image for flash-all recovery — never commit or redistribute
.factory/

# Scratch build output
out/

# Local experiment backups (partition dumps) — never commit
.local/

# Vendored Qualcomm headers for the parked DSI experiment (dsi-call.c);
# re-copy from a factory image if needed — vendor material stays local
# (DECISIONS §7 spirit).
boot/rootfs/src/dsi_netctrl.h
boot/rootfs/src/dsi_netctrl_qos.h
boot/rootfs/src/common_v01.h
boot/rootfs/src/qmi_idl_lib.h
